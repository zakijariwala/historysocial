# Sources stay local. They are never deployed and never committed.
sources/*
!sources/manifest.yaml
!sources/README.md

# Intermediate rendered output. Raw PNGs in out/ are never committed.
out/
*.zip

# Review site data: site/data/ holds the generated index.json and slide PNGs
# that serve as the deploy payload for Cloudflare Pages.

# Scratch database for cover-variant work. Not truth.
scratch.db
scratch.db-wal
scratch.db-shm

__pycache__/
*.pyc
.venv/
.DS_Store
